# Copy to .env and adjust. `.env` is gitignored — never commit real secrets.

# ---- Database ---------------------------------------------------------------
# Matches docker-compose.yml (host port 5433 to avoid clashing with a local
# Postgres install).
DATABASE_URL="postgresql://social_insight:social_insight@localhost:5433/social_insight?schema=public"

# ---- Provider ---------------------------------------------------------------
# mock | facebook | instagram | tiktok
# Stays `mock` until App Review is approved. Everything in stages 1-5 must work
# with this value untouched.
INSIGHT_PROVIDER="mock"

# Seed for MockProvider's generator. A fixed seed makes `pnpm sync` idempotent:
# the same run produces the same external ids and the same numbers.
MOCK_SEED="20260907"

# ---- Sync API route ---------------------------------------------------------
# POST /api/sync must carry `x-sync-secret: <this value>`. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYNC_SECRET=""

# ---- "Underperforming" thresholds (Overview page) ---------------------------
# Each value is a fraction of the account's OWN normal (its median), checked as
# a funnel and stopping at the first broken step:
#   1. reach  < REACH_RATIO x median reach   -> "reach ต่ำ"
#   2. views  < VIEWS_RATIO x median views   -> "ดูน้อย"
#   3. performance score < SCORE             -> "ดูแล้วไม่ interact"
# Leave blank to use the defaults below. Must be > 0 and <= 1.
UNDERPERFORMANCE_REACH_RATIO="0.5"
UNDERPERFORMANCE_VIEWS_RATIO="0.5"
UNDERPERFORMANCE_SCORE="0.5"

# ---- Stage 6 only — leave empty while INSIGHT_PROVIDER=mock -----------------
# 32-byte hex key used to encrypt access tokens before they touch the database.
# Not used yet: the Facebook provider reads its token from the environment on
# every run and stores nothing, so no token ever reaches the database.
TOKEN_ENCRYPTION_KEY=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# ---- Facebook provider (INSIGHT_PROVIDER=facebook) --------------------------
# The numeric Page id, and a Page access token for it. The token is a secret:
# it is sent as an Authorization header, never in a query string, and is never
# written to the database or to raw_payloads.
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_ACCESS_TOKEN=""

# Pin a Graph API version, e.g. "v25.0". Empty = the version recorded as
# verified in lib/providers/facebook/api-spec.ts.
FACEBOOK_GRAPH_VERSION=""

# How many days of posts each sync walks back over (1-365).
FACEBOOK_LOOKBACK_DAYS="90"

# ---- Instagram provider (INSIGHT_PROVIDER=instagram) ------------------------
# Instagram Business accounts are read through the connected Facebook Page's
# own token (confirmed: same graph.facebook.com Graph API as Facebook above) —
# so these are a Page id + Page access token too, not separate Instagram-only
# credentials. Can be the same Page as FACEBOOK_PAGE_ID/FACEBOOK_PAGE_ACCESS_TOKEN
# above, or a different one, if a different app/token pair manages it.
INSTAGRAM_PAGE_ID=""
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_GRAPH_VERSION=""
INSTAGRAM_LOOKBACK_DAYS="90"

# ---- TikTok provider (INSIGHT_PROVIDER=tiktok) ------------------------------
# A "TikTok for Developers" (open.tiktokapis.com) OAuth access token for the
# account's own login — NOT a TikTok for Business/Marketing API credential,
# see lib/providers/tiktok/api-spec.ts for why. Scopes needed: video.list,
# user.info.basic, user.info.stats. TikTok tokens are short-lived (~24h) with
# no refresh implemented here — expect to need a fresh token periodically.
TIKTOK_ACCESS_TOKEN=""
TIKTOK_LOOKBACK_DAYS="90"
